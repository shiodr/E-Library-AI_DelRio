DATABASE_URL=postgresql+pg8000://elibrary:change-this-local-password@localhost:5432/elibrary
APP_ENV=development
CORS_ORIGINS='["https://elibrary-ai.wasmer.app","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","https://localhost","capacitor://localhost"]'
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_HOURS=168
GUEST_SESSION_HOURS=24
# Backend only. Empty key enables catalog retrieval but leaves LLM generation blocked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ASSISTANT_REQUESTS_PER_HOUR=20
ASSISTANT_GLOBAL_REQUESTS_PER_HOUR=100
# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. Keep it in backend-only environment variables, never VITE_*.
SESSION_TOKEN_SECRET=
# Production: APP_ENV=production, SESSION_COOKIE_SECURE=true.
# For separate frontend/API origins use SameSite=none and HTTPS, or prefer a same-site custom domain.
# Wasmer-managed PostgreSQL also supports DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD when DATABASE_URL is unset.
# DB_SSL=true
