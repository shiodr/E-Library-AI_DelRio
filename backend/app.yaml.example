# Deployment preparation only. Resolve the WASIX dependency gate in docs/deployment.md first.
kind: wasmer.io/App.v0
owner: YOUR_WASMER_USERNAME
name: elibrary-ai-api
package: .
debug: false
env:
  APP_ENV: production
  SESSION_COOKIE_SECURE: "true"
  SESSION_COOKIE_SAMESITE: none
  CORS_ORIGINS: '["https://YOUR_WEB_HOST", "https://localhost", "capacitor://localhost"]'
capabilities:
  database:
    engine: postgres
redirect:
  force_https: true
