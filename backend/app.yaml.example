# First run scripts/build_wasmer.py locally. Deploy from backend/, not the monorepo root.
kind: wasmer.io/App.v0
owner: YOUR_WASMER_USERNAME
name: elibrary-ai-api
package: .
debug: false
env:
  APP_ENV: production
  DB_SSL: "true"
  DB_SSL_VERIFY: "false"
  SESSION_COOKIE_SECURE: "true"
  SESSION_COOKIE_SAMESITE: none
  CORS_ORIGINS: '["https://elibrary-ai.wasmer.app", "https://localhost", "capacitor://localhost"]'
capabilities:
  database:
    engine: postgres
redirect:
  force_https: true
