# Copy to backend/.env.production locally; never commit the populated file.
APP_ENV=production
DATABASE_URL=postgresql+pg8000://USERNAME:PASSWORD@POSTGRES_HOST:5432/DATABASE
DB_SSL=true
DB_SSL_VERIFY=true
SESSION_TOKEN_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
CORS_ORIGINS='["https://elibrary-ai.wasmer.app","https://localhost","capacitor://localhost"]'
SESSION_HOURS=168
GUEST_SESSION_HOURS=24
# For Wasmer-managed PostgreSQL, omit DATABASE_URL and use its injected DB_* credentials.
# Wasmer's private CA requires DB_SSL_VERIFY=false; retain DB_SSL=true for encryption.
